# Base de Datos (SQLite para desarrollo local o PostgreSQL/Supabase)
DATABASE_URL=sqlite:///./ganaderia.db

# Configuración de Supabase Storage para fotos de los animales
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui
SUPABASE_BUCKET=fotos-animales

# URL base para la generación de códigos QR (desarrollo local o dominio de producción)
BASE_URL=http://localhost:8000
